# subgate fronting nginx: TLS termination, rate limits, privacy-safe logging,
# and a loopback proxy to the subgate binary.
#
# Installation:
#   Debian/Ubuntu: copy to /etc/nginx/conf.d/subgate.conf (or sites-available/subgate)
#   Replace certificate paths, ssl_certificate, and server_name.
#
# Backend listens on loopback only (config.json: "listen": "127.0.0.1:8080");
# nginx is the only path from the network.
#
# Context note:
# Directives outside the server block (map, log_format, limit_*_zone, upstream)
# must reside in nginx's http { ... } context. Files included from /etc/nginx/conf.d/
# are automatically inside the http context.

# Privacy-preserving URI mapping: redacts secret tokens from URL paths.
# Maps /<token>/clash -> /*/clash, /<token>/v2ray -> /*/v2ray, / -> /, others -> /*
map $uri $subgate_safe_uri {
    ~^/[^/]+/(clash|v2ray)$  "/*/$1";
    ~^/$                     "/";
    default                  "/*";
}

# Redacted operational log format:
# - Replaces raw $request with sanitized "$request_method $subgate_safe_uri $server_protocol".
# - Excludes raw query strings ($query_string), Authorization headers, and Referer ($http_referer).
# - Preserves essential operational metrics: timestamp, client IP, status, bytes sent, duration, user agent.
log_format subgate_privacy '$remote_addr - [$time_iso8601] '
                           '"$request_method $subgate_safe_uri $server_protocol" '
                           '$status $body_bytes_sent $request_time '
                           '"$http_user_agent"';

limit_conn_zone $binary_remote_addr zone=subgate_conn:10m;
limit_req_zone $binary_remote_addr zone=subgate_req:10m rate=20r/s;

# Suppress request details in error log during rate-limit and connection-limit events.
# (nginx's internal error_log format is hardcoded in C and prints $request for warning/error events).
limit_req_log_level notice;
limit_conn_log_level notice;

upstream subgate_backend {
    server 127.0.0.1:8080;
    keepalive 32;
    # Keepalive timeout to backend (60s) is slightly less than subgate's
    # 65s idle timeout so nginx closes idle connections first.
    keepalive_timeout 60s;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    # server_name sub.example.com;

    ssl_certificate /etc/ssl/certs/subgate.crt;
    ssl_certificate_key /etc/ssl/private/subgate.key;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;

    # Privacy access log: uses redacted subgate_privacy format
    access_log /var/log/nginx/subgate.access.log subgate_privacy buffer=32k flush=5s;

    # Error logging considerations:
    # - Standard 'warn' level logs operational warnings while limit_*_log_level notice
    #   prevents rate-limit events from leaking requests into error logs.
    # - In extreme zero-leakage threat models, 'error_log ... crit;' can be set to suppress
    #   upstream timeout request dumps (trade-off: reduced debugging of upstream hiccups).
    # - Protect error log permissions: chmod 0640 /var/log/nginx/subgate.error.log
    error_log /var/log/nginx/subgate.error.log warn;

    # Subscriptions are small refreshes; reject anything bigger early.
    client_max_body_size 1m;

    limit_conn subgate_conn 32;
    limit_req zone=subgate_req burst=40 nodelay;

    location / {
        proxy_pass http://subgate_backend;
        proxy_http_version 1.1;
        # Keep-alive to the backend; the empty Connection value enables it.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

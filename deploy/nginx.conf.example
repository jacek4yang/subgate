# subgate fronting nginx: TLS termination, rate limits, and a loopback
# proxy to the subgate binary. Copy to /etc/nginx/sites-available/subgate and
# replace the certificate paths and server_name.
#
# Backend listens on loopback only (config.json: "listen": "127.0.0.1:8080");
# nginx is the only path from the network.

limit_conn_zone $binary_remote_addr zone=subgate_conn:10m;
limit_req_zone $binary_remote_addr zone=subgate_req:10m rate=20r/s;

upstream subgate_backend {
    server 127.0.0.1:8080;
    keepalive 32;
    # Keepalive timeout to backend (60s) is slightly less than subgate's
    # 65s idle timeout so nginx closes idle connections first.
    keepalive_timeout 60s;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    # server_name sub.example.com;

    ssl_certificate /etc/ssl/certs/subgate.crt;
    ssl_certificate_key /etc/ssl/private/subgate.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    # Subscriptions are small refreshes; reject anything bigger early.
    client_max_body_size 1m;

    limit_conn subgate_conn 32;
    limit_req zone=subgate_req burst=40 nodelay;

    location / {
        proxy_pass http://subgate_backend;
        proxy_http_version 1.1;
        # Keep-alive to the backend; the empty Connection value enables it.
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}

[Unit]
Description=subgate subscription gateway
Documentation=https://github.com/jacek4yang/subgate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/subgate /etc/subgate/config.json
# Synchronous reload via control socket: validates config and applies it atomically.
# Reports actual reload success/failure to systemctl reload (with generation logging).
ExecReload=/usr/local/bin/subgate --reload /etc/subgate/config.json
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
RuntimeDirectory=subgate
RuntimeDirectoryMode=0755
DynamicUser=yes
SupplementaryGroups=subgate
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=256M
TaskMax=512
LimitNOFILE=16384
CapabilityBoundingSet=
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RemoveIPC=yes
ReadOnlyPaths=/etc/subgate

[Install]
WantedBy=multi-user.target

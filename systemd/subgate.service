[Unit]
Description=subgate subscription gateway
Documentation=https://github.com/jacek4yang/subgate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/subgate /etc/subgate/config.json
# Fail `systemctl reload` before the HUP if the new config is invalid.
ExecReload=/usr/local/bin/subgate --check /etc/subgate/config.json
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
TimeoutStopSec=15
DynamicUser=yes
SupplementaryGroups=subgate
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictAddressFamilies=AF_INET AF_INET6
RestrictNamespaces=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
MemoryMax=256M
TaskMax=512
LimitNOFILE=16384
CapabilityBoundingSet=
RestrictSUIDSGID=yes
SystemCallArchitectures=native
RemoveIPC=yes
ReadOnlyPaths=/etc/subgate

[Install]
WantedBy=multi-user.target
